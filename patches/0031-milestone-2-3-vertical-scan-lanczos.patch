+    constexpr int kA = 3;                 // Lanczos 창 반경
+    constexpr int kTaps = 2 * kA;         // 6탭
+    std::vector<float> wtab(static_cast<size_t>(factor) * kTaps);
+    for (int ph = 0; ph < factor; ++ph) {

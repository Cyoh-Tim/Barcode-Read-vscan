@@ -166,6 +166,21 @@ struct PipelineConfig {
      * 비용은 축소본 1회 스캔(~1ms 미만)이고, 코드가 있는 프레임은 첫 블록
      * 몇 개에서 바로 통과하므로 사실상 공짜다.

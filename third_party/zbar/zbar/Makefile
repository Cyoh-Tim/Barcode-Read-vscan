	$(AM_V_at)$(am__mv) $(DEPDIR)/libzbar_la-error.Tpo $(DEPDIR)/libzbar_la-error.Plo
#	$(AM_V_CC)source='error.c' object='libzbar_la-error.lo' libtool=yes \
